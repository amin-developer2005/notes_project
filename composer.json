{
    "name": "mohammadamin/notes-project",
    "description": "A powerfull PHP-based notes management application that allows users to create, edit, and delete personal notes.",
    "type": "project",
    "require": {
        "symfony/http-foundation": "^7.2",
        "symfony/dependency-injection": "^7.2",
        "vlucas/phpdotenv": "v5.6.1",
      "ext-pdo": "*"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Mohammadamin\\NotesProject\\": "src/",
            "Core\\" : "Core/",
            "App\\" : "App/"
        }
    },
    "authors": [
        {
            "name": "mohamadamin meghdadi",
            "email": "mohamadamin.meghdadi@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require-dev": {
        "pestphp/pest": "^3.7"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
